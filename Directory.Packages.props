<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cratis -->
    <PackageVersion Include="Cratis" Version="21.19.3" />
    <PackageVersion Include="Cratis.Arc" Version="21.19.3" />
    <PackageVersion Include="Cratis.Arc.Chronicle" Version="21.19.3" />
    <PackageVersion Include="Cratis.Arc.Chronicle.Testing" Version="21.19.3" />
    <PackageVersion Include="Cratis.Arc.MongoDB" Version="21.19.3" />
    <PackageVersion Include="Cratis.Arc.Swagger" Version="21.19.3" />
    <PackageVersion Include="Cratis.Arc.Testing" Version="21.19.3" />
    <!--
        The Chronicle client packages are pinned here AND referenced directly from Stage and Host - central package
        management only pins what a project references directly, so a version that arrives transitively through the
        Cratis meta-package is whatever that package was built against, never this one. That is how the 3.6.0 image
        shipped Cratis.Chronicle 16.26.0 next to Cratis.Chronicle.Contracts 16.36.2 and crashed at boot with a
        TypeLoadException for the renamed EnsureEventStore contract. The Host Dockerfile's cratis/chronicle base
        image tag must track this version too, so the bundled kernel and the client never drift apart.
    -->
    <PackageVersion Include="Cratis.Chronicle" Version="16.36.2" />
    <PackageVersion Include="Cratis.Chronicle.AspNetCore" Version="16.36.2" />
    <PackageVersion Include="Cratis.Chronicle.Contracts" Version="16.36.2" />
    <PackageVersion Include="MongoDB.Driver" Version="3.11.0" />
    <PackageVersion Include="Cratis.Scene.Engine" Version="2.0.0" />
    <PackageVersion Include="Cratis.Scene.Model" Version="2.0.0" />
    <PackageVersion Include="Cratis.Screenplay" Version="4.2.1" />
    <PackageVersion Include="Cratis.Templates" Version="1.1.1" />
    <!-- Microsoft -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!--
        Microsoft.CodeAnalysis.CSharp 5.9.0 declares a dependency on a prerelease of the analyzers that was never
        published, so restore resolves the stable 5.9.0 and raises NU1603 - an error here, which stopped the whole
        solution building. Referenced directly at the version restore already picks, so the dependency is satisfied
        outright rather than substituted.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <PackageVersion Include="Microsoft.TemplateEngine.Abstractions" Version="10.0.400" />
    <PackageVersion Include="Microsoft.TemplateEngine.Edge" Version="10.0.400" />
    <PackageVersion Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" Version="10.0.400" />
    <!-- OpenAPI -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.16.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.167" />
    <!-- Testing & Specifications -->
    <PackageVersion Include="Cratis.Specifications" Version="4.0.0" />
    <PackageVersion Include="Cratis.Specifications.XUnit" Version="4.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>
</Project>