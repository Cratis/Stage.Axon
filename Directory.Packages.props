<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <PureTransitionReferencePackVersion>10.0.12</PureTransitionReferencePackVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cratis -->
    <PackageVersion Include="Cratis" Version="22.112.1" />
    <PackageVersion Include="Cratis.Fundamentals" Version="7.25.1" />
    <PackageVersion Include="Cratis.Arc" Version="22.112.1" />
    <PackageVersion Include="Cratis.Arc.Chronicle" Version="22.112.1" />
    <PackageVersion Include="Cratis.Arc.Chronicle.Testing" Version="22.112.1" />
    <PackageVersion Include="Cratis.Arc.MongoDB" Version="22.112.1" />
    <PackageVersion Include="Cratis.Arc.Screenplay" Version="22.112.1" />
    <PackageVersion Include="Cratis.Arc.Swagger" Version="22.112.1" />
    <PackageVersion Include="Cratis.Arc.Testing" Version="22.112.1" />
    <!--
        The Chronicle client packages are pinned here AND referenced directly from Stage and Host - central package
        management only pins what a project references directly, so a version that arrives transitively through the
        Cratis meta-package is whatever that package was built against, never this one. That is how the 3.6.0 image
        shipped Cratis.Chronicle 16.26.0 next to Cratis.Chronicle.Contracts 16.36.2 and crashed at boot with a
        TypeLoadException for the renamed EnsureEventStore contract. The Host Dockerfile's cratis/chronicle base
        image tag must track this version too, so the bundled kernel and the client never drift apart.
    -->
    <PackageVersion Include="Cratis.Chronicle" Version="19.83.4" />
    <PackageVersion Include="Cratis.Chronicle.AspNetCore" Version="19.83.4" />
    <PackageVersion Include="Cratis.Chronicle.Contracts" Version="19.83.4" />
    <PackageVersion Include="Cratis.Chronicle.Testing" Version="19.83.4" />
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
    <PackageVersion Include="Cratis.Scene.Engine" Version="4.75.0" />
    <PackageVersion Include="Cratis.Scene.Model" Version="4.75.0" />
    <PackageVersion Include="Cratis.Screenplay" Version="4.236.0" />
    <!-- Spec-only: freezes the released RegisterProject conformance corpus consumed by the Cratis renderer's planner fixtures. -->
    <PackageVersion Include="Cratis.Screenplay.CanonicalCorpus" Version="4.236.0" />
    <PackageVersion Include="Cratis.Templates" Version="1.7.4" />
    <!-- Microsoft -->
    <!-- Audited reducer-binding references, embedded in the renderer for runtime-only hosts. -->
    <PackageVersion Include="Microsoft.NETCore.App.Ref" Version="$(PureTransitionReferencePackVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <!--
        Microsoft.CodeAnalysis.CSharp 5.9.0 declares a dependency on a prerelease of the analyzers that was never
        published, so restore resolves the stable 5.9.0 and raises NU1603 - an error here, which stopped the whole
        solution building. Referenced directly at the version restore already picks, so the dependency is satisfied
        outright rather than substituted.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="Microsoft.TemplateEngine.Abstractions" Version="10.0.402" />
    <PackageVersion Include="Microsoft.TemplateEngine.Edge" Version="10.0.402" />
    <PackageVersion Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" Version="10.0.402" />
    <!-- OpenAPI -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <!-- Reverse proxy for the Chronicle Workbench, which the bundled kernel serves on its own unpublished port. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="Cratis.OpenTelemetry" Version="7.24.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.303" />
    <!-- Testing & Specifications -->
    <PackageVersion Include="Cratis.Specifications" Version="4.1.1" />
    <PackageVersion Include="Cratis.Specifications.XUnit" Version="4.1.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>