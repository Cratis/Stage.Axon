<Project>
  <PropertyGroup>
    <!-- Keep these pins on the same major and no newer than Cratis/cli main; cli-version-guard.mjs fails ahead/incompatible pins and warns on lag in build and publish. -->
    <StageVersion Condition="'$(StageVersion)' == ''">4.205.0</StageVersion>
    <ScreenplayVersion Condition="'$(ScreenplayVersion)' == ''">4.251.0</ScreenplayVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Cratis.Stage.Contracts" Version="$(StageVersion)" />
    <PackageVersion Include="Cratis.Screenplay" Version="$(ScreenplayVersion)" />
    <PackageVersion Include="Cratis.Screenplay.CanonicalCorpus" Version="4.241.0" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.303" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="Cratis.Specifications" Version="4.1.1" />
    <PackageVersion Include="Cratis.Specifications.XUnit" Version="4.1.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>
