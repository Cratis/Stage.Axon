@@ -0,0 +1,33 @@
+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+using Cratis.Screenplay.Semantics;
+using Cratis.Stage.Rendering.Axon.Java;
+
+namespace Cratis.Stage.Rendering.Axon.Emitters.Projections;
+
+internal static class PersistentProjectionStore
+{
+    internal static void Emit(AxonEmissionContext context, ViewJavaTypes types, string package, SemanticReadModel model)
+    {
+        var name = JavaNames.Type(model.Name);
+        var code = new JavaCodeBuilder(package).Declare(name).Declare(name + "StoreConfiguration");
+        var store = code.Reference(types.BasePackage + ".runtime.ReadModelStore");
+        var memory = code.Reference(types.BasePackage + ".runtime.InMemoryReadModelStore");
+        var persistent = code.Reference(types.BasePackage + ".persistence.JpaReadModelStore");
+        var bootstrap = code.Reference(types.BasePackage + ".persistence.PersistentViewConfiguration");
+        var qualifier = JavaCodeBuilder.StringLiteral(package + "." + name);
+        code.DiffersFromScreenplay("Default read-model rows are volatile. The persistent profile supports guarded flat projections only; scoped/reducer state is not recovered (STAGE-AXON-0308).")
+            .Line($"@{code.Reference("org.springframework.context.annotation.Configuration")}({JavaCodeBuilder.StringLiteral(package + "." + name + "StoreConfiguration")})")
+            .Line($"@{code.Reference("org.springframework.context.annotation.PropertySource")}(\"classpath:axon-views.properties\")")
+            .Block($"public class {name}StoreConfiguration", body => body
+                .Line($"@{body.Reference("org.springframework.context.annotation.Profile")}(\"!persistent\")")
+                .Line($"@{body.Reference("org.springframework.context.annotation.Bean")}({qualifier})")
+                .Block($"public {store}<{body.Reference("java.lang.Object")}, {name}> store()", method => method.Line($"return new {memory}<>();"))
+                .Line($"@{body.Reference("org.springframework.context.annotation.Profile")}(\"persistent\")")
+                .Line($"@{body.Reference("org.springframework.context.annotation.Bean")}({qualifier})")
+                .Block($"public {store}<Object, {name}> persistentStore({bootstrap} generation, {body.Reference("jakarta.persistence.EntityManagerFactory")} factory, {body.Reference("tools.jackson.databind.json.JsonMapper")} mapper)", method =>
+                    method.Line($"return new {persistent}<>(factory, mapper, {qualifier}, {name}.class);")));
+        ViewJavaTypes.Add(context, package, name + "StoreConfiguration", code.Build(), model.Id);
+    }
+}
diff --git a/Source/Rendering.Axon/Emitters/Projections/ProjectionHandlerBinding.cs b/Source/Rendering.Axon/Emitters/Projections/ProjectionHandlerBinding.cs
new file mode 100644
index 00000000..58204409
--- /dev/null
+++ b/Source/Rendering.Axon/Emitters/Projections/ProjectionHandlerBinding.cs
@@ -0,0 +1,47 @@
+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+using Cratis.Screenplay.Semantics;
+using Cratis.Stage.Rendering.Axon.Emitters.Persistence;
+using Cratis.Stage.Rendering.Axon.Java;
+
+namespace Cratis.Stage.Rendering.Axon.Emitters.Projections;
+
+internal sealed class ProjectionHandlerBinding(AxonEmissionContext context, ViewJavaTypes types, SemanticReadModel model, string package)
+{
+    readonly ProjectionUpdates _updates = new(context, types, model.Id);
+
+    internal void Emit(JavaCodeBuilder body, string eventType, Action<JavaCodeBuilder> transitions)
+    {
+        if (PersistentViewAdmission.Supports(context, model.Id))
+        {
+            EmitContextual(body, eventType, transitions);
+            return;
+        }
+        body.Line($"@{body.Reference("org.axonframework.messaging.eventhandling.annotation.EventHandler")}")
+            .Block($"public void on({eventType} event{_updates.Parameter})", method => Apply(method, transitions));
+    }
+
+    void EmitContextual(JavaCodeBuilder body, string eventType, Action<JavaCodeBuilder> transitions)
+    {
+        var adapter = body.Reference(types.BasePackage + ".persistence.JpaReadModelStore");
+        var processing = body.Reference("org.axonframework.messaging.core.unitofwork.ProcessingContext");
+        var store = body.Reference(types.BasePackage + ".runtime.ReadModelStore");
+        var arguments = _updates.Enabled ? ", updates" : string.Empty;
+        body.Line($"@{body.Reference("org.axonframework.messaging.eventhandling.annotation.EventHandler")}")
+            .Block($"public void handle({eventType} event{_updates.Parameter}, {processing} context)", method =>
+            {
+                method.Line($"apply(event{_updates.DefaultArgument}, {adapter}.bind(store, context));");
+                if (_updates.Enabled)
+                    method.Block("context.runOnAfterCommit(ignored ->", callback => _updates.Notify(callback, package)).Line(");");
+            })
+            .Block($"public void on({eventType} event{_updates.Parameter})", method => method.Line($"apply(event{arguments}, store);"))
+            .Block($"private void apply({eventType} event{_updates.Parameter}, {store}<Object, {JavaNames.Type(model.Name)}> store)", method => Apply(method, transitions));
+    }
+
+    void Apply(JavaCodeBuilder method, Action<JavaCodeBuilder> transitions)
+    {
+        transitions(method);
+        _updates.Notify(method, package);
+    }
+}
