<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Stage.Rendering.Axon.Verification</AssemblyName>
        <RootNamespace>Cratis.Stage.Rendering.Axon.Verification</RootNamespace>
        <OutputType>Exe</OutputType>
        <!-- The harness has its own top-level entry point; the test-SDK AutoGeneratedProgram clashes with it. -->
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsPackable>false</IsPackable>
        <EnablePackageValidation>false</EnablePackageValidation>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Rendering.Axon/Rendering.Axon.csproj" />
        <PackageReference Include="Cratis.Screenplay.CanonicalCorpus" />
        <None Update="disabled-tests.json" CopyToOutputDirectory="PreserveNewest" />
        <EmbeddedResource Include="Templates/*.java" />
        <EmbeddedResource Include="ClientProof/**/*" LogicalName="ClientProof/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
