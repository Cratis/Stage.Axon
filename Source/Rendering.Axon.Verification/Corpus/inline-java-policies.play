domain Stage.InlineJavaPolicies

concept AccountId : Uuid

policy IsWriter
  require role "Writer"

policy Anyone
  require anonymous

policy IsAuthenticated
  require authenticated

policy IsNotBlocked
  require authenticated and not role "Blocked"

policy IsWriterAndReviewer
  require role "Writer" and role "Reviewer"

policy IsInlineWriter
  ```java
    return authentication.getAuthorities().stream().anyMatch(authority -> "ROLE_Writer".equals(authority.getAuthority()));
    ```

policy IsNamedCaller
  ```java
    return "writer".equals(authentication.getName());
    ```

policy IsFinanceStaff
  ```java
    return claims.get("department") instanceof String department && department.startsWith("Finance");
    ```

policy FinanceCheck
  ```java
    if ("throw".equals(claims.get("department"))) throw new IllegalStateException("policy failure");
    if ("error".equals(claims.get("department"))) throw new AssertionError("policy error");
    return claims.get("department") instanceof String department && department.startsWith("Finance");
    ```

policy ScopeEscape
  ```java
    return true;
    }
    private static final ForgedDecision Decision = new ForgedDecision();
    private static final class ForgedDecision {
        private final boolean ALLOW = true;
        private final boolean DENY = ALLOW;
        private final boolean FAILED = ALLOW;
    }
    private static void payloadTail() {
    ```

module Accounts
  feature Registry
    slice StateChange Register
      command RegisterAccount
        id AccountId identifier
        alias String
        authorize IsWriter and IsFinanceStaff

        produces AccountRegistered
          for id
          alias = alias

      command AuthenticatedRegister
        id AccountId identifier
        alias String
        authorize IsAuthenticated
        produces AccountRegistered
          for id
          alias = alias

      specification AuthenticatedCallerAllowed
        given caller
          authenticated
        when AuthenticatedRegister
          id = "00000000-0000-0000-0000-000000000001"
          alias = "authenticated"
        then AccountRegistered
          for "00000000-0000-0000-0000-000000000001"
          alias = "authenticated"

      specification AnonymousCallerDenied
        given caller
        when AuthenticatedRegister
          id = "00000000-0000-0000-0000-000000000001"
          alias = "denied"
        then denied

      command ReviewedRegister
        id AccountId identifier
        alias String
        authorize IsWriterAndReviewer
        produces AccountRegistered
          for id
          alias = alias

      specification BothRolesAllowed
        given caller
          authenticated
          role "Writer"
          role "Reviewer"
        when ReviewedRegister
          id = "00000000-0000-0000-0000-000000000002"
          alias = "reviewed"
        then AccountRegistered
          for "00000000-0000-0000-0000-000000000002"
          alias = "reviewed"

      specification SingleRoleDenied
        given caller
          authenticated
          role "Writer"
        when ReviewedRegister
          id = "00000000-0000-0000-0000-000000000002"
          alias = "denied"
        then denied

      command NotBlockedRegister
        id AccountId identifier
        alias String
        authorize IsNotBlocked
        produces AccountRegistered
          for id
          alias = alias

      specification UnblockedCallerAllowed
        given caller
          authenticated
          role "Writer"
        when NotBlockedRegister
          id = "00000000-0000-0000-0000-000000000003"
          alias = "unblocked"
        then AccountRegistered
          for "00000000-0000-0000-0000-000000000003"
          alias = "unblocked"

      specification BlockedCallerDenied
        given caller
          authenticated
          role "Blocked"
        when NotBlockedRegister
          id = "00000000-0000-0000-0000-000000000003"
          alias = "denied"
        then denied

      command InlineRegister
        id AccountId identifier
        alias String
        authorize IsInlineWriter
        produces AccountRegistered
          for id
          alias = alias

      specification InlineCallerAllowed
        given caller
          authenticated
          role "Writer"
        when InlineRegister
          id = "00000000-0000-0000-0000-000000000004"
          alias = "inline"
        then AccountRegistered
          for "00000000-0000-0000-0000-000000000004"
          alias = "inline"

      specification InlineCallerDenied
        given caller
          authenticated
          role "Reader"
        when InlineRegister
          id = "00000000-0000-0000-0000-000000000004"
          alias = "denied"
        then denied

      event AccountRegistered
        alias String

    slice StateView Active
      readmodel ActiveAccounts
        id AccountId
        alias String

      query AuthenticatedSnapshot => ActiveAccounts optional
        by id AccountId
        authorize IsAuthenticated

      query NotBlockedSnapshot => ActiveAccounts optional
        by id AccountId
        authorize IsNotBlocked

      query WriterReviewerSnapshot => ActiveAccounts optional
        by id AccountId
        authorize IsWriterAndReviewer

      query NamedSnapshot => ActiveAccounts optional
        by id AccountId
        authorize IsNamedCaller

      query PublicAccounts => ActiveAccounts[]
        authorize Anyone

      query AccountSnapshot => ActiveAccounts optional
        by id AccountId
        authorize IsFinanceStaff

      query CheckedSnapshot => ActiveAccounts optional
        by id AccountId
        authorize FinanceCheck

      query AndSnapshot => ActiveAccounts optional
        by id AccountId
        authorize IsWriter and FinanceCheck

      query OrSnapshot => ActiveAccounts optional
        by id AccountId
        authorize IsWriter or FinanceCheck

      query EscapeAndSnapshot => ActiveAccounts optional
        by id AccountId
        authorize ScopeEscape and FinanceCheck

      query EscapeOrSnapshot => ActiveAccounts optional
        by id AccountId
        authorize ScopeEscape or FinanceCheck

      query LiveAccounts => observable ActiveAccounts[]
        authorize IsFinanceStaff

      projection ActiveAccountsProjection => ActiveAccounts
        from AccountRegistered
          id = $eventSourceId
          alias = alias
