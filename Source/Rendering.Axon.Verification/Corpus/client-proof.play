domain Stage.ClientProof

concept WorkItemId : Uuid

concept WorkItemEmail : String
  validate
    matches "[a-z]+@[a-z]+[.][a-z]{2,}"

concept WorkItemShortTitle : String
  validate
    min 3

type WorkItemContact
  email WorkItemEmail
  title WorkItemShortTitle

concept WorkItemState : Enum
  open
  inProgress
  done

concept WorkItemPriority : Enum
  low = 0
  normal = 5
  high = 10

policy IsEditor
  require role "Editor"

policy IsManager
  require role "Manager"

policy CanWork
  require role "Editor" or role "Manager"

module Work
  feature Items
    slice StateChange Create
      command CreateWorkItem
        id WorkItemId identifier
        name String
        title String
        state WorkItemState
        priority WorkItemPriority
        authorize IsEditor

        produces WorkItemCreated
          for id
          name = name
          title = title
          state = state
          priority = priority

        returns
          id = id
          name = name

      event WorkItemCreated
        name String
        title String
        state WorkItemState
        priority WorkItemPriority

      constraint UniqueWorkItemName
        unique name on WorkItemCreated

    slice StateChange Rename
      command RenameWorkItem
        id WorkItemId identifier
        title String
        authorize IsEditor

        produces WorkItemRenamed
          for id
          title = title

      event WorkItemRenamed
        title String

      specification NativeFixtureAllowsEditor
        given caller
          authenticated
          role "Editor"
        when RenameWorkItem
          id = "00000000-0000-0000-0000-000000000001"
          title = "Allowed"
        then WorkItemRenamed
          for "00000000-0000-0000-0000-000000000001"
          title = "Allowed"

      specification NativeFixtureDeniesViewer
        given caller
          authenticated
          role "Viewer"
        when RenameWorkItem
          id = "00000000-0000-0000-0000-000000000002"
          title = "Denied"
        then denied

    slice StateChange ManagerRename
      command ManagerRenameWorkItem
        id WorkItemId identifier
        title String
        authorize CanWork and IsManager

        produces WorkItemRenamed
          for id
          title = title

      specification NativeFixtureAllowsManager
        given caller
          authenticated
          role "Manager"
        when ManagerRenameWorkItem
          id = "00000000-0000-0000-0000-000000000003"
          title = "Manager allowed"
        then WorkItemRenamed
          for "00000000-0000-0000-0000-000000000003"
          title = "Manager allowed"

      specification NativeFixtureDeniesEditor
        given caller
          authenticated
          role "Editor"
        when ManagerRenameWorkItem
          id = "00000000-0000-0000-0000-000000000004"
          title = "Editor denied"
        then denied

    slice StateChange RequestWireNames
      command EchoClass
        class String
        authorize IsEditor

        returns
          value = class

    slice StateView Overview
      readmodel WorkItems
        workItemId WorkItemId
        name String
        title String
        state WorkItemState
        priority WorkItemPriority

      query WorkItemById => observable WorkItems optional
        by workItemId WorkItemId
        authorize IsEditor

      query WorkItemByName => WorkItems[]
        by name String
        authorize IsEditor

      query AllWorkItems => observable WorkItems[]
        authorize IsEditor

      projection WorkItemsProjection => WorkItems
        from WorkItemCreated
          workItemId = $eventSourceId
          name = name
          title = title
          state = state
          priority = priority
        from WorkItemRenamed
          title = title

    slice StateChange RegisterContact
      command RecordContact
        id WorkItemEmail identifier
        email WorkItemEmail
        details WorkItemContact
        state WorkItemState
        authorize IsEditor

        produces ContactRecorded
          for email
          email = email
          details = details
          state = state

    slice StateView Contacts
      event ContactRecorded
        email WorkItemEmail
        details WorkItemContact
        state WorkItemState

      readmodel WorkItemContacts
        email WorkItemEmail
        details WorkItemContact
        state WorkItemState

      query ContactByEmail => WorkItemContacts optional
        by email WorkItemEmail
        authorize IsEditor

      projection ContactsProjection => WorkItemContacts
        from ContactRecorded
          key email
          email = email
          details = details
          state = state

      specification RichContactExample
        given ContactRecorded
          for "writer@example.test"
          email = "writer@example.test"
          details = {"email":"writer@example.test","title":"Valid"}
          state = "open"
        then readmodel WorkItemContacts
          email = "writer@example.test"
          details = {"email":"writer@example.test","title":"Valid"}
          state = "open"
