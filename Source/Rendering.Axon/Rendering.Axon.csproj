<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Published library: net10.0 and net11.0. Debug (inline specs) runs on net11.0 only. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks Condition="'$(Configuration)' == 'Release'">net10.0;net11.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(Configuration)' != 'Release'">net11.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <!-- Override the inherited source default; a command-line -p:Version still takes precedence. -->
        <Version>0.0.0-local</Version>
        <AssemblyName>Cratis.Stage.Rendering.Axon</AssemblyName>
        <RootNamespace>Cratis.Stage.Rendering.Axon</RootNamespace>
        <Description>Axon Framework JVM artifact planning from Screenplay executable semantic models</Description>
        <PackageTags>cratis;screenplay;stage;axon;java;code-generation</PackageTags>
        <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Cratis.Stage.Contracts" />
    <PackageReference Include="Cratis.Screenplay" />
        <EmbeddedResource Include="Emitters/Runtime/Templates/**/*.java" />
        <EmbeddedResource Include="Emitters/Scaffold/Assets/*" />
        <EmbeddedResource Include="Emitters/Client/Templates/**/*.ts" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Cratis.Screenplay.CanonicalCorpus" />
        <Compile Include="../Rendering.Axon.Verification/CanonicalCorpusInputs.cs" Link="Specs/CanonicalCorpusInputs.cs" />
    </ItemGroup>
</Project>
