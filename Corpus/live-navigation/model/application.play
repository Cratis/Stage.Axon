concept OrderId : Uuid
concept TicketId : Uuid

layout AppShell
  category application
  topbar
  outlet Navigation of navigation in navigation
  content
  side

  arrangement flow
    column
      topbar height 56
      row gap 16
        navigation width 240
        content grow

  outlet topbar of navigation
    logo image "" title "Acme"
    default sales title "Sales" target Sales
    default support title "Support" target Support

  outlet sidebar of navigation
    default home title "Home" target Home

ui profile Desktop
  target platform web
  target size expanded
  root template AppShell
  packages
    core

module Home
  feature Welcome
    slice StateView WelcomeInfo
      readmodel WelcomeRow
        id OrderId key
        text String
      screen Welcome
        title "Welcome"

module Sales
  form PlaceOrderForm for PlaceOrder
    field orderId
    field customer
    field quantity

  outlet sidebar overrides
    item orders title "Orders" target Sales.Orders
    item customers title "Customers" target Sales.Customers

  feature Orders
    slice StateChange PlaceOrder
      command PlaceOrder
        orderId OrderId identifier
        customer String
        quantity Int
        produces OrderPlaced
          for orderId
          orderId = orderId
          customer = customer
          quantity = quantity
      event OrderPlaced
        orderId OrderId
        customer String
        quantity Int
      screen NewOrder
        title "New order"
        action PlaceOrder
    slice StateView OrderList
      readmodel OrderRow
        orderId OrderId key
        customer String
        quantity Int
      screen List
        title "Orders"
        toolbar actions
          button new title "New order" slice Sales.Orders.PlaceOrder emphasis primary icon plus
  feature Customers
    slice StateView CustomerList
      readmodel CustomerRow
        id OrderId key
        name String
      screen CustomerScreen
        title "Customers"

module Support
  feature Tickets
    slice StateView TicketList
      readmodel TicketRow
        id TicketId key
        subject String
      screen TicketScreen
        title "Tickets"
